{
  "name": "qr-code-buddy-extension",
  "description": "The simple QR Code Generator that does the thing and does it well.",
  "version": "2.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm prepare:manifest-locales && wxt",
    "dev:firefox": "pnpm prepare:manifest-locales && wxt -b firefox",
    "dev:chrome": "pnpm prepare:manifest-locales && wxt -b chrome",
    "dev:edge": "pnpm prepare:manifest-locales && wxt -b edge",
    "prepare:rules": "node scripts/convert-clearurls-rules.mjs",
    "update:rules": "node scripts/update-clearurls-rules.mjs",
    "prepare:manifest-locales": "node scripts/generate-manifest-locales.mjs",
    "prepare:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "build": "pnpm prepare:paraglide && pnpm prepare:manifest-locales && pnpm prepare:rules && pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "pnpm prepare:rules && pnpm prepare:manifest-locales && pnpm zip:chrome && pnpm zip:firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "check": "pnpm prepare:paraglide && svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare && pnpm prepare:rules && pnpm prepare:paraglide && pnpm prepare:manifest-locales",
    "lint": "eslint && prettier --check .",
    "format": "prettier --write .",
    "check:i18n": "inlang check --project ./project.inlang",
    "lint:i18n": "eslint --config ./eslint.paraglide.config.mjs ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@inlang/paraglide-js": "^3.2.2",
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.4",
    "daisyui": "^5.7.27",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.4",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.4",
    "@inlang/cli": "^3.4.0",
    "@typescript-eslint/parser": "^8.71.2"
  },
  "dependencies": {
    "@lucide/svelte": "^1.39.0",
    "@sveltejs/eslint-config": "^10.0.4",
    "@wxt-dev/i18n": "^0.2.8",
    "eslint": "^10.0.0",
    "eslint-plugin-lube": "^0.5.1",
    "eslint-plugin-svelte": "^3.15.0",
    "prettier": "^3.2.4",
    "prettier-plugin-svelte": "^3.4.0",
    "qr-code-styling": "^1.9.2"
  }
}
